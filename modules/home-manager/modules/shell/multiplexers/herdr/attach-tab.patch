 use super::*;
 
+static ATTACH_TAB_FOCUS_SENT: std::sync::atomic::AtomicBool =
+    std::sync::atomic::AtomicBool::new(false);
+
 impl ClientShellState {
+    /// Once the first snapshot is in, a client started with `HERDR_ATTACH_TAB`
+    /// asks over its own connection to view that tab. The server applies a
+    /// focus that arrives this way to this client only, so the views of the
+    /// other clients stay where they are.
+    pub(crate) fn take_attach_tab_focus(&mut self) -> Vec<ClientShellAction> {
+        if self.snapshot.is_none()
+            || ATTACH_TAB_FOCUS_SENT.swap(true, std::sync::atomic::Ordering::Relaxed)
+        {
+            return Vec::new();
+        }
+        let Ok(tab_id) = std::env::var("HERDR_ATTACH_TAB") else {
+            return Vec::new();
+        };
+        let mut outcome = ClientShellInput::default();
+        self.push_endpoint_method(
+            crate::api::schema::Method::TabFocus(crate::api::schema::TabTarget { tab_id }),
+            &mut outcome,
+        );
+        outcome.actions
+    }
+
